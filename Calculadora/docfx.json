{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../Calculadora",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "styles/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/custom"
    ],
    "globalMetadata": {
      "_appName": "Calculadora Mejorada",
      "_appTitle": "Calculadora Mejorada — Documentación",
      "_enableSearch": true,
      "_appFooter": "Calculadora Mejorada — Documentación generada con DocFX",
      "_appCss": "styles/main.css",
      "_appAdditionalJavaScript": "styles/inject.js",
      "pdf": true
    }
  }
}